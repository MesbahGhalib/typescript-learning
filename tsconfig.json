{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    // Recommended Options
    "strict": true,

    "skipLibCheck": true,
    "moduleDetection": "force"
  }
}
